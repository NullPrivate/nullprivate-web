{
  "name": "nullprivate-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4321",
    "start": "astro dev --port 4321",
    "build": "astro build",
    "build:nullprivate": "BRAND=nullprivate astro build",
    "build:adguardprivate": "BRAND=adguardprivate astro build",
    "build:all": "npm run build:nullprivate && npm run build:adguardprivate",
    "preview": "astro preview --port 4321",
    "astro": "astro",
    "typecheck": "astro check",
    "test:homepage": "node --test scripts/test-homepage.mjs",
    "test:marketing": "node --test scripts/test-marketing.mjs",
    "test:docs-navigation": "node --test scripts/test-docs-navigation.mjs",
    "test:markdown-lists": "node --test scripts/test-markdown-lists.mjs",
    "test:media": "node --test scripts/test-media.mjs",
    "translate:marketing": "node scripts/translate-marketing.mjs",
    "migrate:content": "node scripts/migrate-content.mjs --lang zh-cn",
    "migrate:content:all": "node scripts/migrate-content.mjs --lang all",
    "migrate:content:dry": "node scripts/migrate-content.mjs --lang all --dry-run",
    "migrate:assets": "node scripts/migrate-content.mjs --assets-only",
    "upload:r2:preview": "npm run build:nullprivate && wrangler deploy --config wrangler.jsonc",
    "upload:r2:preview:adguardprivate": "npm run build:adguardprivate && wrangler deploy --config wrangler.preview.adguardprivate.jsonc",
    "upload:aliyun:preview": "npm run build:adguardprivate && node scripts/run-rclone.js sync dist/adguardprivate/ ${OSS_PREVIEW_TARGET:-aliyun_oss_hangzhou:www-adguardprivate-com-astro-preview} --config ${RCLONE_CONFIG:-./rclone.conf} --checksum --fast-list --transfers 8 --checkers 16 -v -P --stats 2s --stats-file-name-length 0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@astrojs/starlight": "^0.42.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
