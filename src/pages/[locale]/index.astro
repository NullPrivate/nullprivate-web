---
import HomePage from '../../components/marketing/HomePage.astro';
import { getMessages } from '../../lib/i18n';
import { defaultLocale, locales, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<HomePage locale={locale} messages={getMessages(locale).home} />