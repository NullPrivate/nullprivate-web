---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<MarketingLayout title="博客" description="NullPrivate 技术分享与产品更新">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-[var(--brand-text)]">博客</h1>
    <p class="mt-3 text-slate-600">
      博客列表将按现网日期 permalink 迁移：<code>/blog/:year/:month/:day/:slug/</code>。
    </p>
    <div class="mt-8 rounded-3xl bg-[var(--brand-surface)] p-6 ring-1 ring-slate-200">
      <p class="text-sm text-slate-600">内容迁移脚本就绪前，这里先作为信息架构占位。</p>
      <a class="mt-4 inline-flex text-sm font-semibold text-[var(--brand-primary)]" href="/docs/">先看文档 →</a>
    </div>
  </div>
</MarketingLayout>
