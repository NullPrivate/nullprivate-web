---
import BlogArticle from '../../../../../components/marketing/BlogArticle.astro';
import { getBlogStaticPaths, type BlogEntry } from '../../../../../lib/blog';

export async function getStaticPaths() {
  return getBlogStaticPaths('zh-cn');
}

interface Props { post: BlogEntry }
const { post } = Astro.props;
---

<BlogArticle post={post} locale="zh-cn" />
