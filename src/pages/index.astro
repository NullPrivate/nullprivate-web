---
import Hero from '../components/marketing/Hero';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getBrand } from '../lib/brand';

const brand = getBrand();
---

<MarketingLayout title="专业的隐私保护与防沉迷服务" description={brand.description}>
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-10">
    <Hero
      title={brand.siteName}
      subtitle={brand.subtitle}
      description="基于加密 DNS 的广告拦截、隐私保护与家庭防沉迷服务。无需注册，多设备可用，文档与购买路径更短。"
      client:load
    />

    <section class="grid gap-4 md:grid-cols-3">
      {[
        ['首屏更聚焦转化', '主 CTA 直达定价，次 CTA 进入上手文档'],
        ['文档继续用 Starlight', '侧栏、目录、多语言与搜索能力开箱可用'],
        ['双品牌同内容源', 'nullprivate / adguardprivate 只切换 brand config'],
      ].map(([title, text]) => (
        <article class="rounded-3xl bg-[var(--brand-surface)] p-5 ring-1 ring-slate-200">
          <h2 class="text-lg font-semibold text-[var(--brand-text)]">{title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
        </article>
      ))}
    </section>

    <section class="rounded-3xl bg-slate-900 px-6 py-8 text-white">
      <h2 class="text-2xl font-semibold">从看到到下单，只留必要步骤</h2>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">
        脚手架阶段先打通首页、定价骨架、文档入口与双品牌构建。完整支付流、内容迁移与 Pagefind 按蓝图后续推进。
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-full bg-teal-400 px-5 py-3 text-sm font-semibold text-slate-950" href="/pricing/">去定价页</a>
        <a class="rounded-full bg-white/10 px-5 py-3 text-sm font-semibold ring-1 ring-white/20" href="/docs/">去文档</a>
      </div>
    </section>
  </div>
</MarketingLayout>
