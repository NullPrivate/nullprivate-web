---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getBrand } from '../../lib/brand';
import { displayBrandName, localizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/site';
import sourceMessages from '../../i18n/zh-cn/home.json';

interface Props {
  locale?: Locale;
  messages?: typeof sourceMessages;
}

const { locale = 'zh-cn', messages = sourceMessages } = Astro.props;
const brand = getBrand();
const withBrand = (message: string) => message.replaceAll('{brandName}', displayBrandName(locale, brand.siteName));
const { features, scenarios, steps, platforms, faqs } = messages;
---

<MarketingLayout locale={locale} title={messages.metadata.title} description={withBrand(messages.metadata.description)}>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{withBrand(messages.hero.eyebrow)}</p>
        <h1 id="hero-title">{messages.hero.title}</h1>
        <p class="hero-description">{messages.hero.description}</p>
        <div class="actions">
          <a class="button button-primary" href={localizedPath('/pricing/', locale)} data-cta="hero_pricing">{messages.hero.primaryLabel} <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={localizedPath('/docs/startup/config/', locale)} data-cta="hero_docs">{messages.hero.secondaryLabel}</a>
        </div>
        <ul class="hero-benefits" aria-label={messages.hero.benefitsLabel}>
          {messages.hero.benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>
      </div>
      <figure class="protection-map">
        <figcaption><span class="map-dot" aria-hidden="true"></span> {messages.diagram.caption} <span class="diagram-label">{messages.diagram.label}</span></figcaption>
        <div class="device-row">{messages.diagram.devices.map((device) => <span>{device}</span>)}</div>
        <div class="connection"><span>{messages.diagram.connection}</span></div>
        <div class="dns-node">
          <svg width="32" height="36" viewBox="0 0 32 36" fill="none" aria-hidden="true"><path d="M16 3 28 8v9c0 7-5 12-12 16C9 29 4 24 4 17V8L16 3Z" stroke="currentColor" stroke-width="2"/><path d="m10 17 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div><strong>{withBrand(messages.diagram.title)}</strong><span>{messages.diagram.description}</span></div>
        </div>
        <ul class="filter-results">
          {messages.diagram.results.map((result) => (
            <li><span><i class:list={['result-dot', { allow: result.allowed }]} aria-hidden="true"></i>{result.label}</span><strong>{result.action}</strong></li>
          ))}
        </ul>
        <p class="diagram-note">{messages.diagram.note}</p>
      </figure>
    </section>

    <section class="section" aria-labelledby="features-title">
      <div class="section-heading"><p class="eyebrow">{messages.featuresSection.eyebrow}</p><h2 id="features-title">{messages.featuresSection.title}</h2><p>{messages.featuresSection.description}</p></div>
      <div class="card-grid">
        {features.map((feature) => <article class="feature-card"><span class="card-number" aria-hidden="true">{feature.number}</span><h3>{feature.title}</h3><p>{feature.description}</p><a class="text-link" href={localizedPath(feature.href, locale)}>{feature.label} <span aria-hidden="true">↗</span></a></article>)}
      </div>
      <p class="scope-note">{messages.featuresSection.note}</p>
    </section>

    <section class="family-section" aria-labelledby="family-title">
      <div class="section-heading"><p class="eyebrow">{messages.familySection.eyebrow}</p><h2 id="family-title">{messages.familySection.title}</h2><p>{messages.familySection.description}</p></div>
      <div class="card-grid">
        {scenarios.map((scenario) => <article class="scenario-card"><span class="tag">{scenario.tag}</span><h3>{scenario.title}</h3><p>{scenario.text}</p><a class="text-link" href={localizedPath(scenario.href, locale)}>{scenario.label} <span aria-hidden="true">↗</span></a></article>)}
      </div>
    </section>

    <section class="section" aria-labelledby="setup-title">
      <div class="section-heading"><p class="eyebrow">{messages.setupSection.eyebrow}</p><h2 id="setup-title">{messages.setupSection.title}</h2><p>{messages.setupSection.description}</p></div>
      <ol class="steps">
        {steps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p><a class="text-link" href={localizedPath(step.href, locale)}>{step.label} <span aria-hidden="true">↗</span></a></li>)}
      </ol>
      <nav class="platforms" aria-label={messages.setupSection.platformsLabel}><span>{messages.setupSection.platformsPrompt}</span>{platforms.map((platform) => <a href={localizedPath(`/docs/startup/config/${platform.slug}/`, locale)}>{platform.name} <span aria-hidden="true">↗</span></a>)}</nav>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading"><p class="eyebrow">{messages.faqSection.eyebrow}</p><h2 id="faq-title">{messages.faqSection.title}</h2><p>{messages.faqSection.description}</p><a class="text-link" href={localizedPath('/docs/faq/', locale)}>{messages.faqSection.label} <span aria-hidden="true">↗</span></a></div>
      <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{faq.answer}</p><a class="text-link" href={localizedPath(faq.href, locale)}>{faq.label} <span aria-hidden="true">↗</span></a></div></details>)}</div>
    </section>

    <section class="open-source" aria-labelledby="open-source-title">
      <div class="section-heading">
        <p class="eyebrow">{messages.openSource.eyebrow}</p>
        <h2 id="open-source-title">{messages.openSource.title}</h2>
        <p>{withBrand(messages.openSource.description)}</p>
      </div>
      <div class="actions">
        <a class="button button-secondary" href="https://github.com/NullPrivate/NullPrivate">{messages.openSource.repositoryLabel} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={localizedPath('/docs/feature/open-source/', locale)}>{messages.openSource.docsLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div><p class="eyebrow">{messages.closing.eyebrow}</p><h2 id="closing-title">{messages.closing.title}</h2><p>{messages.closing.description}</p></div>
      <div class="actions"><a class="button button-primary" href={localizedPath('/pricing/', locale)} data-cta="footer_pricing">{messages.closing.primaryLabel} <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={localizedPath('/docs/startup/free/', locale)} data-cta="footer_public">{messages.closing.secondaryLabel}</a></div>
    </section>
  </div>
</MarketingLayout>

<script>
  import { trackEvent } from '../analytics/track';

  document.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((link) => {
    link.addEventListener('click', () => trackEvent('cta_click', { cta: link.dataset.cta }));
  });
</script>

<style>
  .home { color: var(--marketing-text); background: var(--marketing-bg); max-width: 1152px; margin-inline: auto; padding: 32px 24px 64px; overflow-wrap: anywhere; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: 48px; padding: 64px 48px; border: 1px solid var(--marketing-border); border-radius: 28px; background: linear-gradient(120deg, var(--marketing-soft), var(--marketing-surface) 70%); }
  .eyebrow { color: var(--marketing-primary); font-size: 13px; font-weight: 650; letter-spacing: .08em; margin: 0 0 16px; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 24px; font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.3; font-weight: 750; letter-spacing: -.04em; text-wrap: balance; }
  .hero-copy, .protection-map { min-width: 0; }
  h1, h2, h3, .button, .text-link { overflow-wrap: anywhere; }
  .hero-description { max-width: 34em; color: var(--marketing-muted); font-size: 16px; line-height: 1.9; margin-bottom: 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: 16px; min-height: 48px; padding: 12px 20px; border: 1px solid transparent; border-radius: 10px; font-size: 14px; font-weight: 650; transition: background-color 160ms ease, box-shadow 160ms ease; }
  .button-primary { background: var(--marketing-primary); color: var(--marketing-on-primary); }
  .button-primary:hover { background: color-mix(in srgb, var(--marketing-primary) 85%, var(--marketing-strong)); }
  .button-secondary { background: var(--marketing-surface); border-color: var(--marketing-control-border); color: var(--marketing-text); }
  .button-secondary:hover { background: var(--marketing-soft); }
  .hero-benefits { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; padding: 0; margin: 24px 0 0; font-size: 13px; color: var(--marketing-muted); }
  .hero-benefits li::before { content: '✓'; color: var(--marketing-primary); margin-right: 6px; }
  .protection-map { margin: 0; padding: 24px; border: 1px solid var(--marketing-border); border-radius: 20px; background: var(--marketing-surface); box-shadow: 0 16px 40px color-mix(in srgb, var(--marketing-text) 4%, transparent); }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; }
  .map-dot, .result-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--marketing-primary); flex-shrink: 0; }
  .diagram-label { margin-left: auto; padding: 3px 7px; border: 1px solid var(--marketing-border); border-radius: 5px; font-size: 11px; color: var(--marketing-muted); font-weight: 400; }
  .device-row { display: flex; gap: 8px; margin-top: 28px; }
  .device-row span { flex: 1; border: 1px solid var(--marketing-border); background: var(--marketing-surface); border-radius: 8px; text-align: center; padding: 10px 4px; font-size: 13px; }
  .connection { display: flex; justify-content: center; padding: 18px 0; background: linear-gradient(var(--marketing-border), var(--marketing-border)) center / 1px 100% no-repeat; }
  .connection span { font-size: 11px; color: var(--marketing-muted); background: var(--marketing-surface); padding: 3px 8px; }
  .dns-node { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 18px 12px; border: 1px solid var(--marketing-control-border); border-radius: 10px; background: var(--marketing-soft); color: var(--marketing-primary); }
  .dns-node strong { display: block; font-size: 15px; }
  .dns-node div > span { display: block; margin-top: 3px; font-size: 12px; color: var(--marketing-muted); }
  .filter-results { list-style: none; padding: 0; margin: 16px 0; }
  .filter-results li { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--marketing-border); font-size: 12px; }
  .filter-results li > span { display: flex; align-items: center; gap: 8px; }
  .result-dot { background: var(--marketing-muted); width: 6px; height: 6px; }
  .result-dot.allow { background: var(--marketing-primary); }
  .filter-results strong { font-weight: 500; color: var(--marketing-muted); }
  .diagram-note { margin: 0; color: var(--marketing-muted); font-size: 11px; line-height: 1.7; }
  .section { padding-block: 80px; }
  .section-heading { margin-bottom: 32px; }
  h2 { margin-bottom: 16px; font-size: clamp(1.5rem, 2.7vw, 2rem); font-weight: 700; line-height: 1.4; letter-spacing: -.025em; text-wrap: balance; }
  .section-heading > p:not(.eyebrow) { color: var(--marketing-muted); font-size: 15px; line-height: 1.8; margin-bottom: 0; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .feature-card, .scenario-card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; border-radius: 16px; border: 1px solid var(--marketing-border); }
  .card-number { color: var(--marketing-primary); font-size: 14px; font-weight: 650; margin-bottom: 24px; }
  h3 { font-size: 18px; font-weight: 650; line-height: 1.5; margin-bottom: 12px; text-wrap: balance; }
  .feature-card p, .scenario-card p, .steps p { color: var(--marketing-muted); font-size: 14px; line-height: 1.9; margin-bottom: 20px; }
  .text-link { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; color: var(--marketing-primary); text-underline-offset: 5px; }
  .text-link:hover { text-decoration: underline; }
  .feature-card .text-link, .scenario-card .text-link, .steps .text-link { margin-top: auto; }
  .scope-note { margin: 20px 0 0; padding-left: 12px; border-left: 2px solid var(--marketing-control-border); color: var(--marketing-muted); font-size: 12px; line-height: 1.8; }
  .family-section { padding: 40px; border-radius: 24px; background: var(--marketing-surface); }
  .family-section .card-grid { gap: 32px; }
  .scenario-card { padding: 0; border: 0; border-radius: 0; }
  .tag { padding: 5px 10px; border-radius: 6px; background: var(--marketing-soft); color: var(--marketing-primary); font-size: 12px; font-weight: 600; margin-bottom: 20px; }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; list-style: none; padding: 0; margin: 0; }
  .steps li { display: flex; flex-direction: column; align-items: flex-start; border-top: 1px solid var(--marketing-border); padding-top: 24px; }
  .step-number { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: var(--marketing-soft); border-radius: 50%; color: var(--marketing-primary); font-size: 13px; font-weight: 650; margin-bottom: 20px; }
  .platforms { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; border: 1px solid var(--marketing-border); border-radius: 12px; padding: 16px 20px; margin-top: 32px; }
  .platforms > span { font-size: 13px; color: var(--marketing-muted); margin-right: auto; }
  .platforms a { display: inline-flex; gap: 12px; align-items: center; padding: 8px 12px; min-height: 44px; border-radius: 6px; font-size: 13px; background: var(--marketing-surface); }
  .platforms a:hover { background: var(--marketing-soft); }
  .faq-section { display: grid; grid-template-columns: 1fr 1.7fr; gap: 56px; padding-block: 16px 80px; }
  .faq-section .section-heading .text-link { margin-top: 16px; }
  details { border-bottom: 1px solid var(--marketing-border); }
  details:first-child { border-top: 1px solid var(--marketing-border); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 4px; cursor: pointer; font-size: 15px; font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--marketing-primary); }
  .faq-toggle { font-size: 22px; line-height: 1; font-weight: 400; color: var(--marketing-primary); }
  details[open] .faq-toggle { transform: rotate(45deg); }
  .faq-answer { padding: 0 4px 20px; }
  .faq-answer p { font-size: 14px; line-height: 1.9; color: var(--marketing-muted); margin-bottom: 8px; }
  .closing { background: var(--marketing-strong); color: var(--marketing-on-strong); border-radius: 24px; padding: 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .closing .eyebrow { color: var(--marketing-on-strong); }
  .closing p:not(.eyebrow) { max-width: 36em; font-size: 14px; line-height: 1.8; color: var(--marketing-on-strong); margin-bottom: 0; }
  .closing .button-primary { background: var(--marketing-on-strong); color: var(--marketing-strong); }
  .closing .button-primary:hover { background: color-mix(in srgb, var(--marketing-on-strong) 90%, var(--marketing-strong)); }
  .closing .button-secondary { background: transparent; color: var(--marketing-on-strong); border-color: var(--marketing-control-border); }
  .closing .button-secondary:hover { background: color-mix(in srgb, var(--marketing-on-strong) 7%, transparent); }
  .open-source { padding: 32px; margin-bottom: 40px; border: 1px solid var(--marketing-border); border-radius: 20px; background: var(--marketing-surface); }
  .open-source .section-heading { margin-bottom: 20px; }
  .open-source .actions { align-items: center; }
  @media (max-width: 1000px) {
    .hero { gap: 28px; padding: 40px 28px; }
    .protection-map { padding: 20px; }
    .card-grid { gap: 16px; }
    .feature-card { padding: 24px 20px; }
    .family-section { padding: 32px; }
  }
  @media (max-width: 760px) {
    .home { padding: 20px 20px 40px; }
    .hero { grid-template-columns: 1fr; padding: 32px 24px; gap: 32px; border-radius: 20px; }
    .hero-copy { max-width: 36em; }
    .protection-map { width: 100%; max-width: 440px; justify-self: center; }
    .section { padding-block: 56px; }
    .card-grid, .steps, .faq-section { grid-template-columns: 1fr; }
    .feature-card { padding: 24px; }
    .card-number { margin-bottom: 16px; }
    .family-section { padding: 28px 24px; }
    .family-section .card-grid { gap: 24px; }
    .scenario-card + .scenario-card { border-top: 1px solid var(--marketing-border); padding-top: 24px; }
    .steps { gap: 24px; }
    .platforms { padding: 16px; gap: 8px; }
    .platforms > span { width: 100%; margin-bottom: 4px; }
    .faq-section { gap: 0; padding-bottom: 56px; }
    .closing { padding: 32px 24px; }
    .open-source { padding: 28px 24px; }
  }
  @media (max-width: 400px) {
    h1 { font-size: clamp(1.5rem, 7.4vw, 1.85rem); }
    .home { padding-inline: 16px; }
    .hero { padding-inline: 20px; }
    .actions { width: 100%; }
    .actions .button { width: 100%; }
    .hero-benefits { gap: 8px 12px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
