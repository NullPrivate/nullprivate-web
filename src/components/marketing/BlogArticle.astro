---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { blogAlternates, blogPermalink, formatBlogDate, localizeBlogHtml, parseBlogDate, type BlogEntry } from '../../lib/blog';
import { getBrand } from '../../lib/brand';
import { getMessages, localizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/site';

interface Props { post: BlogEntry; locale: Locale }
const { post, locale } = Astro.props;
const { common } = getMessages(locale);
const [entries, docs] = await Promise.all([getCollection('blog'), getCollection('docs')]);
const alternates = blogAlternates(post, entries);
// glob loader 在内容同步时生成 HTML，复用同一份 Markdown 渲染结果。
if (post.rendered?.html === undefined) throw new Error(`博客尚未渲染：${post.id}`);
const html = localizeBlogHtml(post.rendered.html, locale, entries, docs, getBrand().siteUrl, blogPermalink(post)!);
---

<MarketingLayout locale={locale} alternates={alternates} title={post.data.title} description={post.data.description || post.data.title}>
  <article class="blog-article">
    <a class="back-link" href={localizedPath('/blog/', locale)}><span aria-hidden="true">← </span>{common.backToBlog}</a>
    <header>
      <p class="published"><span>{common.publishedOn}</span> <time datetime={parseBlogDate(post.data.pubDate)?.toISOString()}>{formatBlogDate(post, locale)}</time></p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lead">{post.data.description}</p>}
    </header>
    <div class="blog-body" set:html={html} />
  </article>
</MarketingLayout>

<style>
  .blog-article { max-width: 820px; margin: auto; padding: 48px 24px 80px; color: var(--marketing-text); overflow-wrap: anywhere; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--marketing-primary); }
  header { margin: 28px 0 36px; padding-bottom: 32px; border-bottom: 1px solid var(--marketing-border); }
  .published { color: var(--marketing-muted); font-size: .9rem; }
  h1 { margin-top: 16px; font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 750; line-height: 1.3; }
  .lead { margin-top: 24px; color: var(--marketing-muted); line-height: 1.9; font-size: 1.1rem; }
  .blog-body { line-height: 1.9; }
  .blog-body :global(p), .blog-body :global(figure) { margin-block: 1.25em; }
  .blog-body :global(h1), .blog-body :global(h2), .blog-body :global(h3), .blog-body :global(h4), .blog-body :global(h5), .blog-body :global(h6) { margin: 1.8em 0 .7em; color: var(--marketing-text); font-weight: 700; line-height: 1.4; scroll-margin-top: 24px; }
  .blog-body :global(h1), .blog-body :global(h2) { font-size: 1.65rem; }
  .blog-body :global(h3) { font-size: 1.3rem; }
  .blog-body :global(a), .back-link:hover { color: var(--marketing-primary); text-decoration: underline; text-underline-offset: 4px; }
  .blog-body :global(img), .blog-body :global(video), .blog-body :global(svg) { max-width: 100%; height: auto; }
  .blog-body :global(img) { display: block; margin-block: 24px; border-radius: 12px; }
  .blog-body :global(iframe) { max-width: 100%; }
  .blog-body :global(blockquote) { margin-block: 24px; padding: 4px 20px; border-inline-start: 3px solid var(--marketing-primary); background: var(--marketing-soft); color: var(--marketing-muted); }
  .blog-body :global(pre) { max-width: 100%; overflow-x: auto; margin-block: 24px; padding: 20px; border: 1px solid var(--marketing-border); border-radius: 12px; }
  .blog-body :global(pre), .blog-body :global(pre span) { background-color: var(--marketing-surface) !important; color: var(--marketing-text) !important; }
  .blog-body :global(code) { font-size: .9em; }
  .blog-body :global(:not(pre) > code) { padding: .15em .35em; background: var(--marketing-soft); color: var(--marketing-text); border-radius: 4px; }
  .blog-body :global(table) { display: block; max-width: 100%; overflow-x: auto; margin-block: 24px; border-collapse: collapse; }
  .blog-body :global(th), .blog-body :global(td) { border: 1px solid var(--marketing-border); padding: 10px 14px; }
  .blog-body :global(th) { background: var(--marketing-soft); font-weight: 700; }
  .blog-body :global(hr) { margin-block: 32px; border-color: var(--marketing-border); }
  .blog-body :global(figcaption) { color: var(--marketing-muted); font-size: .9rem; text-align: center; }
  @media (max-width: 600px) { .blog-article { padding: 28px 20px 56px; } }
</style>